#!/bin/sh
# gecko — deletion as an output. POSIX sh + git, zero dependencies.
#
#   gecko review [--base REF] [--json] [--tests] [--all]
#   gecko check                          ratchet: fail on new findings
#   gecko baseline [--update]            regenerate the baseline
#   gecko hook install|uninstall         git pre-commit hook
#   gecko help
#
# State lives in <repo>/.gecko/ : config (optional) and baseline (committed).

set -eu

PROG=gecko
VERSION=0.8.0
OWNER=lucasvidela94
REPO=gecko
TAB=$(printf '\t')
TEST_RE='(__tests__/|(^|/)tests/|(^|/)test_|_test[.]|[.]test[.]|[.]spec[.])'

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
gecko_dir() { printf '%s/.gecko\n' "$(repo_root)"; }

self_path() {
  case "$0" in
    /*) printf '%s\n' "$0" ;;
    */*) printf '%s/%s\n' "$(pwd)" "$0" ;;
    *) command -v "$PROG" 2>/dev/null || printf '%s/%s\n' "$(pwd)" "$0" ;;
  esac
}

load_config() {
  cfg="$(gecko_dir)/config"
  [ -f "$cfg" ] || return 0
  if ! git ls-files --error-unmatch .gecko/config >/dev/null 2>&1; then
    printf '%s: ignoring untracked .gecko/config; commit it to enable the detector.\n' "$PROG" >&2
    return 0
  fi
  if [ "${GECKO_QUIET:-0}" != "1" ]; then
    printf '%s: sourcing .gecko/config (this executes repo code).\n' "$PROG" >&2
  fi
  # shellcheck source=/dev/null
  . "$cfg"
}

usage() {
  cat <<'EOF'
gecko — deletion as an output. POSIX sh + git, zero deps.

usage:
  gecko review [--base REF] [--json] [--tests] [--all]
                                       show the diff as reap targets
  gecko check [--json]                 ratchet: fail on new findings
  gecko baseline [--update]            show what would freeze; --update writes it
  gecko hook install|uninstall         git pre-commit hook
  gecko version                        print the version
  gecko self-update [--check]          update the CLI from GitHub releases
  gecko help

config:   committed .gecko/config may define gecko_detect() printing "<path><TAB><finding>".
baseline: .gecko/baseline (commit it).
EOF
}

# --- detection -------------------------------------------------------------

# Default detector: comment-shaped `ponytail:` / `gecko:` markers. Skips docs,
# vendor, markdown and editor/agent trees. Normalized to "<path><TAB><reason>"
# so moving a line does not register as a new finding.
gecko_detect_default() {
  git grep -nE '^[[:space:]]*(#|//|--)[[:space:]]*(ponytail|gecko):' -- . \
    ':(exclude).gecko/**' \
    ':(exclude)docs/**' \
    ':(exclude)vendor/**' \
    ':(exclude).agents/**' \
    ':(exclude).cursor/**' \
    ':(exclude)*.md' \
    ':(exclude)**/*.md' \
    2>/dev/null | awk '
    {
      i = index($0, ":")
      if (i == 0) next
      p = substr($0, 1, i-1)
      rest = substr($0, i+1)
      j = index(rest, ":")
      if (j == 0) next
      s = substr(rest, j+1)
      if (match(s, /(ponytail|gecko):[[:space:]]*/)) {
        t = substr(s, RSTART+RLENGTH)
        sub(/[[:space:]]+$/, "", t)
        print p "\t" t
      }
    }'
}

detect() {
  if command -v gecko_detect >/dev/null 2>&1; then
    gecko_detect
  else
    gecko_detect_default
  fi
}

run_detect() {
  DETECT_STATUS=0
  detect > "$1" 2> "$2" || DETECT_STATUS=$?
}

fail_detector() {
  json=${1:-0}
  if [ "$json" -eq 1 ]; then
    printf '{"verdict":"detector_failed","new_count":0,"gone_count":0,"findings":[]}\n'
  fi
  printf '%s: detector failed (exit %s)\n' "$PROG" "$DETECT_STATUS" >&2
  if [ -s "$2" ]; then
    cat "$2" >&2
  fi
  printf '%s: fix the detector; refusing to report a clean ratchet.\n' "$PROG" >&2
  exit 1
}

# Honest first run: the default detector only sees annotations, so say so.
warn_no_detector() {
  [ "${GECKO_QUIET:-0}" = "1" ] && return 0
  if command -v gecko_detect >/dev/null 2>&1; then return 0; fi
  printf '%s: no detector configured; using the annotation ratchet (ponytail:/gecko: markers).\n' "$PROG" >&2
  printf '%s: add gecko_detect() to .gecko/config for real dead-code detection (GECKO_QUIET=1 silences this).\n' "$PROG" >&2
}

norm_path() {
  printf '%s\n' "$1" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n > 0) n--; continue }
      n++
      s[n] = $i
    }
    out = ""
    for (i = 1; i <= n; i++) out = out s[i] "/"
    if (out == "") print "."
    else { sub(/\/$/, "", out); print out }
  }'
}

try_file() {
  p=$1
  for c in "$p" "$p.ts" "$p.tsx" "$p.js" "$p.jsx" "$p.mjs" "$p.cjs" "$p.py" \
    "$p/index.ts" "$p/index.tsx" "$p/index.js" "$p/index.mjs" "$p/__init__.py"; do
    if [ -f "$c" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

resolve_spec() {
  from=$1
  spec=$2
  hit=
  case "$spec" in
    ''|'.'|'..') return 1 ;;
    @/*)
      rest=${spec#@/}
      for p in "$rest" "src/$rest" "app/$rest" "lib/$rest"; do
        hit=$(try_file "$p" || true)
        if [ -n "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
      done
      return 1
      ;;
    ~/*)
      hit=$(try_file "${spec#~/}" || true)
      if [ -n "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
      return 1
      ;;
    ./*|../*)
      hit=$(try_file "$(norm_path "$(dirname "$from")/$spec")" || true)
      if [ -n "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
      return 1
      ;;
    @*) return 1 ;;
    *.*)
      py=$(printf '%s\n' "$spec" | tr '.' '/')
      hit=$(try_file "$py" || true)
      if [ -n "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
      return 1
      ;;
    *) return 1 ;;
  esac
}

extract_specs() {
  awk '
    function spec_from(line,   s) {
      if (match(line, /from[[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^from[[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /from[[:space:]]+\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^from[[:space:]]+\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (match(line, /require[[:space:]]*\([[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^require[[:space:]]*\([[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /require[[:space:]]*\([[:space:]]*\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^require[[:space:]]*\([[:space:]]*\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (match(line, /import[[:space:]]*\([[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^import[[:space:]]*\([[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /import[[:space:]]*\([[:space:]]*\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^import[[:space:]]*\([[:space:]]*\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (line ~ /^[[:space:]]*from[[:space:]]+[A-Za-z_.\/]+[[:space:]]+import[[:space:]]/) {
        s = line
        sub(/^[[:space:]]*from[[:space:]]+/, "", s)
        sub(/[[:space:]]+import[[:space:]].*/, "", s)
        return s
      }
      return ""
    }
    {
      s = spec_from($0)
      if (s != "") print s
    }
  '
}

files_mentioning() {
  needle=$1
  [ -n "$needle" ] || return 0
  git grep -l -F -e "$needle" -- . ':(exclude).gecko/**' 2>/dev/null || true
}

orphan_has_callers() {
  resolved=$1
  exclude=$2
  base_no_ext=${resolved%.*}
  bn=$(basename "$base_no_ext")
  if [ "$bn" = "index" ] || [ "$bn" = "__init__" ]; then
    bn=$(basename "$(dirname "$resolved")")
  fi
  {
    files_mentioning "$base_no_ext"
    files_mentioning "$bn"
  } | LC_ALL=C sort -u > "$tmp/hits"
  n_callers=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$f" = "$resolved" ] && continue
    grep -Fxq "$f" "$exclude" 2>/dev/null && continue
    n_callers=$((n_callers + 1))
  done < "$tmp/hits"
  [ "$n_callers" -gt 0 ]
}

add_orphan() {
  hop=$1
  path=$2
  via=$3
  grep -Fxq "$path" "$tmp/orphan_set" 2>/dev/null && return 0
  if [ "$show_tests" -eq 0 ] && printf '%s' "$path" | grep -Eq "$TEST_RE"; then
    return 0
  fi
  printf '%s\n' "$path" >> "$tmp/orphan_set"
  printf '%s\t%s\t%s\n' "$hop" "$path" "$via" >> "$tmp/orphans"
}

collect_orphans() {
  : > "$tmp/orphans"
  : > "$tmp/orphan_set"
  : > "$tmp/seeds"
  : > "$tmp/consumers"
  git diff -U0 "$base" -- . ':(exclude).gecko/**' | awk '
    function spec_from(line,   s) {
      if (match(line, /from[[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^from[[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /from[[:space:]]+\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^from[[:space:]]+\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (match(line, /require[[:space:]]*\([[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^require[[:space:]]*\([[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /require[[:space:]]*\([[:space:]]*\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^require[[:space:]]*\([[:space:]]*\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (match(line, /import[[:space:]]*\([[:space:]]+"[^"]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^import[[:space:]]*\([[:space:]]+"/, "", s)
        sub(/"$/, "", s)
        return s
      }
      if (match(line, /import[[:space:]]*\([[:space:]]*\047[^\047]+\047/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/^import[[:space:]]*\([[:space:]]*\047/, "", s)
        sub(/\047$/, "", s)
        return s
      }
      if (line ~ /^[[:space:]]*from[[:space:]]+[A-Za-z_.\/]+[[:space:]]+import[[:space:]]/) {
        s = line
        sub(/^[[:space:]]*from[[:space:]]+/, "", s)
        sub(/[[:space:]]+import[[:space:]].*/, "", s)
        return s
      }
      return ""
    }
    /^--- / {
      file = $0
      sub(/^--- /, "", file)
      if (file ~ /^[a-z]\//) file = substr(file, 3)
      if (file == "/dev/null") file = ""
      next
    }
    /^\+\+\+/ { next }
    /^diff / { next }
    /^@@/ { next }
    /^-/ && $0 !~ /^-{3}/ {
      s = spec_from(substr($0, 2))
      if (s != "" && file != "") print file "\t" s
    }
  ' > "$tmp/dropped_imports"

  while IFS="$TAB" read -r consumer spec; do
    [ -n "$spec" ] || continue
    resolved=$(resolve_spec "$consumer" "$spec" || true)
    [ -n "$resolved" ] && [ -f "$resolved" ] || continue
    printf '%s\n' "$consumer" >> "$tmp/consumers"
    printf '%s\t%s\n' "$resolved" "$consumer" >> "$tmp/seeds"
  done < "$tmp/dropped_imports"

  git diff --name-only --diff-filter=D "$base" -- . ':(exclude).gecko/**' > "$tmp/deleted_files"
  while IFS= read -r del; do
    [ -n "$del" ] || continue
    printf '%s\n' "$del" >> "$tmp/consumers"
    git show "$base:$del" 2>/dev/null | extract_specs > "$tmp/del_specs" || true
    while IFS= read -r spec; do
      [ -n "$spec" ] || continue
      resolved=$(resolve_spec "$del" "$spec" || true)
      [ -n "$resolved" ] && [ -f "$resolved" ] || continue
      printf '%s\t%s\n' "$resolved" "$del" >> "$tmp/seeds"
    done < "$tmp/del_specs"
  done < "$tmp/deleted_files"

  LC_ALL=C sort -u "$tmp/consumers" -o "$tmp/consumers"
  : > "$tmp/exclude"

  while IFS="$TAB" read -r resolved consumer; do
    [ -n "$resolved" ] || continue
    grep -Fxq "$resolved" "$tmp/orphan_set" 2>/dev/null && continue
    cat "$tmp/consumers" > "$tmp/exclude"
    if orphan_has_callers "$resolved" "$tmp/exclude"; then continue; fi
    add_orphan 0 "$resolved" "$consumer"
  done < "$tmp/seeds"

  : > "$tmp/hop_seeds"
  while IFS="$TAB" read -r hop path via; do
    [ "$hop" = "0" ] || continue
    extract_specs < "$path" > "$tmp/hop_specs" || true
    while IFS= read -r spec; do
      [ -n "$spec" ] || continue
      resolved=$(resolve_spec "$path" "$spec" || true)
      [ -n "$resolved" ] && [ -f "$resolved" ] || continue
      grep -Fxq "$resolved" "$tmp/orphan_set" 2>/dev/null && continue
      printf '%s\t%s\n' "$resolved" "$path" >> "$tmp/hop_seeds"
    done < "$tmp/hop_specs"
  done < "$tmp/orphans"

  while IFS="$TAB" read -r resolved via; do
    [ -n "$resolved" ] || continue
    grep -Fxq "$resolved" "$tmp/orphan_set" 2>/dev/null && continue
    cat "$tmp/consumers" "$tmp/orphan_set" > "$tmp/exclude"
    if orphan_has_callers "$resolved" "$tmp/exclude"; then continue; fi
    add_orphan 1 "$resolved" "$via"
  done < "$tmp/hop_seeds"
}

# --- review ----------------------------------------------------------------

cmd_review() {
  base=HEAD
  json=0
  show_tests=0
  show_all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || die "--base requires a ref"; base=$2; shift 2 ;;
      --json) json=1; shift ;;
      --tests) show_tests=1; shift ;;
      --all) show_all=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "review: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root); cd "$root" || die "cannot cd to repo root"
  git rev-parse --verify -q "$base" >/dev/null 2>&1 || die "review: unknown ref '$base'"
  tmp=$(mktemp -d) || die "mktemp failed"
  trap 'rm -rf "$tmp"' EXIT INT TERM

  git diff --numstat "$base" -- . ':(exclude).gecko/**' > "$tmp/numstat"
  git ls-files --others --exclude-standard -- . ':(exclude).gecko/**' > "$tmp/untracked" 2>/dev/null || : > "$tmp/untracked"
  git diff --name-only --diff-filter=A "$base" -- . ':(exclude).gecko/**' > "$tmp/newfiles"

  awk -F'\t' '$1 ~ /^[0-9]+$/ && $1 > 0 && $2 == 0 { printf "%s\t%s\n", $1, $3 }' "$tmp/numstat" \
    | sort -rn -k1,1 > "$tmp/cands_raw"
  while IFS="$TAB" read -r a p; do
    if grep -Fxq "$p" "$tmp/newfiles" 2>/dev/null; then tag=new; else tag=grew; fi
    printf '%s\t%s\t%s\n' "$tag" "$a" "$p"
  done < "$tmp/cands_raw" > "$tmp/cands_tagged"

  if [ "$show_tests" -eq 0 ]; then
    awk -F'\t' -v re="$TEST_RE" '$3 ~ re { n++ } END { printf "%d\n", n + 0 }' \
      "$tmp/cands_tagged" > "$tmp/n_tests"
    awk -F'\t' -v re="$TEST_RE" '$3 !~ re' "$tmp/cands_tagged" > "$tmp/cands"
  else
    printf '0\n' > "$tmp/n_tests"
    cp "$tmp/cands_tagged" "$tmp/cands"
  fi
  n_tests=$(cat "$tmp/n_tests")

  awk -F'\t' '$1 == "grew" { printf "%s\t%s\n", $2, $3 }' "$tmp/cands" > "$tmp/grew"
  awk -F'\t' '$1 == "new"  { printf "%s\t%s\n", $2, $3 }' "$tmp/cands" > "$tmp/new"
  n_grew=$(wc -l < "$tmp/grew" | tr -d ' ')
  n_new=$(wc -l < "$tmp/new" | tr -d ' ')

  awk -F'\t' '$1 ~ /^[0-9]+$/ { printf "%s\t%s\t%s\n", $1, $2, $3 }' "$tmp/numstat" > "$tmp/touched"
  n_touched=$(awk -F'\t' '$1 ~ /^[0-9]+$/ && !($1 > 0 && $2 == 0)' "$tmp/touched" | wc -l | tr -d ' ')
  awk -F'\t' '$1 ~ /^[0-9]+$/ { a += $1; d += $2 } END { printf "%d\t%d\n", a, d }' "$tmp/numstat" > "$tmp/totals"
  read -r total_added total_deleted < "$tmp/totals"

  : > "$tmp/untracked_vis"
  untracked_lines=0
  n_untracked=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$show_tests" -eq 0 ] && printf '%s' "$f" | grep -Eq "$TEST_RE"; then
      n_tests=$((n_tests + 1))
      continue
    fi
    n=$(wc -l < "$f" 2>/dev/null | tr -d ' ' || printf '0')
    untracked_lines=$((untracked_lines + n))
    n_untracked=$((n_untracked + 1))
    printf '%s\t%s\n' "$n" "$f" >> "$tmp/untracked_vis"
  done < "$tmp/untracked"
  total_added=$((total_added + untracked_lines))

  n_orphans=0
  if [ -s "$tmp/numstat" ] || [ -s "$tmp/untracked_vis" ]; then
    collect_orphans
    n_orphans=$(wc -l < "$tmp/orphans" | tr -d ' ')
  fi

  if [ ! -s "$tmp/numstat" ] && [ ! -s "$tmp/untracked_vis" ]; then
    if [ "$json" -eq 1 ]; then
      printf '{"base":"%s","clean":true}\n' "$base"
    else
      printf 'gecko review (base: %s)\n\nclean — nothing to reap.\n' "$base"
    fi
    return 0
  fi

  if [ "$json" -eq 1 ]; then
    esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
    ratio_json=$(awk -v a="$total_added" -v d="$total_deleted" 'BEGIN { if (d == 0) print "null"; else printf "%.2f", a/d }')

    # Mirror the human caps: machine output must not be a token trap either.
    # --all lifts them, and "truncated" says plainly that rows were omitted.
    if [ "$show_all" -eq 1 ]; then
      new_cap=$n_new
      touched_cap=$n_touched
      orphan_cap=$n_orphans
    else
      new_cap=15
      touched_cap=20
      orphan_cap=15
    fi
    truncated=false
    if [ "$n_new" -gt "$new_cap" ] || [ "$n_touched" -gt "$touched_cap" ] || [ "$n_orphans" -gt "$orphan_cap" ]; then
      truncated=true
    fi

    printf '{"base":"%s","added":%s,"deleted":%s,"ratio":%s,"tests_hidden":%s,"grew":%s,"new":%s,"orphans":%s,"truncated":%s,"candidates":[' \
      "$base" "$total_added" "$total_deleted" "$ratio_json" "$n_tests" "$n_grew" "$n_new" "$n_orphans" "$truncated"

    first=1
    while IFS="$TAB" read -r a p; do
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","added":%s,"kind":"grew"}' "$(printf '%s' "$p" | esc)" "$a"
    done < "$tmp/grew"

    shown=0
    while IFS="$TAB" read -r a p; do
      if [ "$shown" -ge "$new_cap" ]; then break; fi
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","added":%s,"kind":"new"}' "$(printf '%s' "$p" | esc)" "$a"
      shown=$((shown + 1))
    done < "$tmp/new"

    printf '],"touched":['
    first=1
    shown=0
    while IFS="$TAB" read -r a d p; do
      if [ "$a" -gt 0 ] && [ "$d" -eq 0 ]; then continue; fi
      if [ "$shown" -ge "$touched_cap" ]; then break; fi
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","added":%s,"deleted":%s}' "$(printf '%s' "$p" | esc)" "$a" "$d"
      shown=$((shown + 1))
    done < "$tmp/touched"

    printf '],"untracked":['
    first=1
    while IFS="$TAB" read -r n f; do
      [ -n "$f" ] || continue
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","lines":%s}' "$(printf '%s' "$f" | esc)" "$n"
    done < "$tmp/untracked_vis"
    printf '],"orphan_files":['
    first=1
    shown=0
    while IFS="$TAB" read -r hop p via; do
      [ -n "$p" ] || continue
      if [ "$shown" -ge "$orphan_cap" ]; then break; fi
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","via":"%s","hop":%s}' "$(printf '%s' "$p" | esc)" "$(printf '%s' "$via" | esc)" "$hop"
      shown=$((shown + 1))
    done < "$tmp/orphans"
    printf ']}\n'
    return 0
  fi

  printf 'gecko review (base: %s)\n\n' "$base"

  if [ -s "$tmp/orphans" ]; then
    printf 'ORPHANS (lost a caller in this diff, nothing else references them)\n'
    shown=0
    while IFS="$TAB" read -r hop p via; do
      [ -n "$p" ] || continue
      if [ "$show_all" -eq 0 ] && [ "$shown" -ge 15 ]; then break; fi
      if [ "$hop" = "0" ]; then
        printf '  %-44s via %s\n' "$p" "$via"
      else
        printf '  %-44s via %s  hop %s\n' "$p" "$via" "$hop"
      fi
      shown=$((shown + 1))
    done < "$tmp/orphans"
    if [ "$show_all" -eq 0 ] && [ "$n_orphans" -gt "$shown" ]; then
      printf '  ... and %s more (--all)\n' "$((n_orphans - shown))"
    fi
    printf '\n'
  fi

  if [ -s "$tmp/grew" ]; then
    printf 'GREW (existed before, added lines, deleted none)\n'
    while IFS="$TAB" read -r a p; do
      printf '  %-44s +%-6s -0\n' "$p" "$a"
    done < "$tmp/grew"
    printf '\n'
  fi

  if [ -s "$tmp/new" ]; then
    printf 'NEW FILES (all additions by definition)\n'
    shown=0
    while IFS="$TAB" read -r a p; do
      if [ "$show_all" -eq 0 ] && [ "$shown" -ge 15 ]; then break; fi
      printf '  %-44s +%-6s -0\n' "$p" "$a"
      shown=$((shown + 1))
    done < "$tmp/new"
    if [ "$show_all" -eq 0 ] && [ "$n_new" -gt "$shown" ]; then
      printf '  ... and %s more (--all)\n' "$((n_new - shown))"
    fi
    printf '\n'
  fi

  if [ "$n_touched" -gt 0 ]; then
    printf 'TOUCHED (added and removed)\n'
    shown=0
    while IFS="$TAB" read -r a d p; do
      if [ "$a" -gt 0 ] && [ "$d" -eq 0 ]; then continue; fi
      if [ "$show_all" -eq 0 ] && [ "$shown" -ge 20 ]; then break; fi
      net=$((a - d))
      if [ "$net" -lt 0 ]; then
        printf '  %-44s +%-6s -%-6s net %-6s shrunk\n' "$p" "$a" "$d" "$net"
      else
        printf '  %-44s +%-6s -%-6s net +%s\n' "$p" "$a" "$d" "$net"
      fi
      shown=$((shown + 1))
    done < "$tmp/touched"
    if [ "$show_all" -eq 0 ] && [ "$n_touched" -gt "$shown" ]; then
      printf '  ... and %s more (--all)\n' "$((n_touched - shown))"
    fi
    printf '\n'
  fi

  if [ -s "$tmp/untracked_vis" ]; then
    printf 'untracked (not in --numstat)\n'
    while IFS="$TAB" read -r n f; do
      [ -n "$f" ] || continue
      printf '  %-44s +%s\n' "$f" "$n"
    done < "$tmp/untracked_vis"
    printf '\n'
  fi

  ratio=$(awk -v a="$total_added" -v d="$total_deleted" 'BEGIN { if (d == 0) print "n/a"; else printf "%.1f", a/d }')
  printf 'summary: +%s -%s  ratio %s:1  (grew: %s, new: %s, tests hidden: %s, untracked: %s, orphans: %s)\n' \
    "$total_added" "$total_deleted" "$ratio" "$n_grew" "$n_new" "$n_tests" "$n_untracked" "$n_orphans"
}

# --- ratchet ---------------------------------------------------------------

cmd_check() {
  json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "check: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root); cd "$root" || die "cannot cd to repo root"
  load_config
  warn_no_detector
  dir=$(gecko_dir)
  baseline="$dir/baseline"
  tmp=$(mktemp -d) || die "mktemp failed"
  trap 'rm -rf "$tmp"' EXIT INT TERM

  run_detect "$tmp/raw" "$tmp/detect.err"
  if [ "$DETECT_STATUS" -ne 0 ]; then
    fail_detector "$json" "$tmp/detect.err"
  fi
  LC_ALL=C sort -u "$tmp/raw" > "$tmp/current"

  if [ ! -f "$baseline" ]; then
    printf '%s: no baseline at %s\n' "$PROG" "$baseline" >&2
    printf 'run: %s baseline --update\n' "$PROG" >&2
    exit 1
  fi
  LC_ALL=C sort -u "$baseline" > "$tmp/base"

  # lower collation pinned: comm silently produces nonsense across locales
  gone=$(LC_ALL=C comm -23 "$tmp/base" "$tmp/current" || true)
  new=$(LC_ALL=C comm -13 "$tmp/base" "$tmp/current" || true)
  n_gone=$(printf '%s\n' "$gone" | grep -c . || true)
  n_new=$(printf '%s\n' "$new" | grep -c . || true)

  if [ "$json" -eq 1 ]; then
    esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
    if [ "$n_new" -gt 0 ]; then verdict=findings; else verdict=clean; fi
    printf '{"verdict":"%s","new_count":%s,"gone_count":%s,"findings":[' "$verdict" "$n_new" "$n_gone"
    printf '%s\n' "$new" > "$tmp/newlist"
    first=1
    while IFS="$TAB" read -r p k; do
      [ -n "$p" ] || continue
      if [ "$first" -eq 0 ]; then printf ','; fi; first=0
      printf '{"path":"%s","key":"%s"}' "$(printf '%s' "$p" | esc)" "$(printf '%s' "$k" | esc)"
    done < "$tmp/newlist"
    printf ']}\n'
    if [ "$n_new" -gt 0 ]; then exit 1; fi
    exit 0
  fi

  if [ "$n_gone" -gt 0 ]; then
    printf 'note: %s baselined finding(s) are gone. Tighten with: %s baseline --update\n\n' "$n_gone" "$PROG"
  fi

  if [ "$n_new" -gt 0 ]; then
    printf 'NEW findings (nothing references these):\n\n' >&2
    printf '%s\n' "$new" | sed 's/^/  /' >&2
    printf '\nWire it up, delete it, or update the baseline saying why in the commit.\n' >&2
    exit 1
  fi

  printf 'no new findings\n'
}

cmd_baseline() {
  update=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --update) update=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "baseline: unknown argument '$1'" ;;
    esac
  done

  root=$(repo_root); cd "$root" || die "cannot cd to repo root"
  load_config
  warn_no_detector
  dir=$(gecko_dir)
  baseline="$dir/baseline"
  tmp=$(mktemp -d) || die "mktemp failed"
  trap 'rm -rf "$tmp"' EXIT INT TERM

  run_detect "$tmp/raw" "$tmp/detect.err"
  if [ "$DETECT_STATUS" -ne 0 ]; then
    fail_detector 0 "$tmp/detect.err"
  fi
  LC_ALL=C sort -u "$tmp/raw" > "$tmp/current"
  n=$(grep -c . "$tmp/current" || true)

  if [ "$update" -eq 0 ]; then
    printf '%s finding(s) would be frozen in %s.\n' "$n" "$baseline"
    printf 're-run with --update to write it.\n'
    return 0
  fi

  mkdir -p "$dir"
  cp "$tmp/current" "$baseline"
  printf 'baseline updated: %s entries -> %s\n' "$n" "$baseline"
}

# --- hook ------------------------------------------------------------------

cmd_hook() {
  action=${1:-}
  root=$(repo_root); cd "$root" || die "cannot cd to repo root"
  hook="$root/.git/hooks/pre-commit"
  marker='# gecko:ratchet'

  case "$action" in
    install)
      abs=$(self_path)
      if [ -f "$hook" ] && ! grep -qF "$marker" "$hook"; then
        printf '%s: pre-commit already exists and is not ours. Append:\n' "$PROG" >&2
        printf '  %s\n' "$marker" >&2
        printf '  exec "%s" check\n' "$abs" >&2
        exit 1
      fi
      mkdir -p "$root/.git/hooks"
      {
        printf '#!/bin/sh\n'
        printf '%s\n' "$marker"
        printf 'exec "%s" check\n' "$abs"
      } > "$hook"
      chmod +x "$hook"
      printf 'installed pre-commit hook -> %s\n' "$hook"
      ;;
    uninstall)
      if [ -f "$hook" ] && grep -qF "$marker" "$hook"; then
        rm -f "$hook"
        printf 'removed pre-commit hook\n'
      else
        printf 'no gecko hook installed\n'
      fi
      ;;
    *) die "hook: expected install|uninstall" ;;
  esac
}

# --- self-update -----------------------------------------------------------

cmd_self_update() {
  check_only=0
  force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check_only=1; shift ;;
      --force) force=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "self-update: unknown argument '$1'" ;;
    esac
  done

  self=$(self_path)
  dir=$(dirname "$self")

  # A sibling SKILL.md means the skills CLI owns this file, not us.
  if [ -f "$dir/../SKILL.md" ] && [ "$force" -eq 0 ]; then
    printf 'gecko lives inside a skill folder; the skills CLI owns it.\n' >&2
    printf 'update it with:  npx skills update\n' >&2
    printf 'override with:   %s self-update --force\n' "$PROG" >&2
    return 0
  fi

  command -v curl >/dev/null 2>&1 || die "curl is required for self-update"

  latest=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
    "https://github.com/$OWNER/$REPO/releases/latest" 2>/dev/null \
    | sed -E 's#.*/tag/##' || true)
  case "$latest" in
    v[0-9]*) : ;;
    *) die "could not determine the latest release (offline?)" ;;
  esac
  latest_v=${latest#v}

  if [ "$latest_v" = "$VERSION" ]; then
    printf 'gecko is up to date (%s)\n' "$VERSION"
    return 0
  fi

  is_newer=$(awk -v a="$latest_v" -v b="$VERSION" 'BEGIN {
    split(a, x, "."); split(b, y, ".");
    for (i = 1; i <= 3; i++) {
      if (x[i]+0 > y[i]+0) { print 1; exit }
      if (x[i]+0 < y[i]+0) { print 0; exit }
    }
    print 0
  }')
  if [ "$is_newer" -eq 0 ] && [ "$force" -eq 0 ]; then
    printf 'gecko %s is newer than the latest release (%s); nothing to do\n' "$VERSION" "$latest_v"
    return 0
  fi

  if [ "$check_only" -eq 1 ]; then
    printf 'current: %s   latest: %s\n' "$VERSION" "$latest_v"
    return 0
  fi

  # Download beside the target so the replace is an atomic rename.
  tmp="$dir/.$PROG.tmp.$$"
  trap 'rm -f "$tmp"' EXIT INT TERM
  curl -fsSL "https://raw.githubusercontent.com/$OWNER/$REPO/$latest/skills/gecko/scripts/gecko" -o "$tmp" \
    || die "download failed ($latest)"
  grep -q '^VERSION=' "$tmp" || die "downloaded file does not look like gecko"
  chmod 755 "$tmp"
  mv "$tmp" "$self" || die "could not replace $self"
  printf 'updated gecko %s -> %s\n' "$VERSION" "$latest_v"
}

# --- dispatch --------------------------------------------------------------

case "${1:-help}" in
  review) shift; cmd_review "$@" ;;
  check) shift; cmd_check "$@" ;;
  baseline) shift; cmd_baseline "$@" ;;
  hook) shift; cmd_hook "$@" ;;
  version|--version|-v) printf '%s %s\n' "$PROG" "$VERSION" ;;
  self-update|update) shift; cmd_self_update "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$1' (try: $PROG help)" ;;
esac
